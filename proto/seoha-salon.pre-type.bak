<title>서하의 살롱 체험판</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=Noto+Serif+KR:wght@600;700;900&family=Cormorant+Garamond:ital,wght@1,600;1,700&display=swap">
<style>
/* Layout: one full-height vertical stage (phone frame on desktop). Two stacked <video> layers crossfade; subtitles in large serif at mid-height; interaction sheets rise from the bottom. Single dark look by design. */
:root{
  --bg:#07060a; --stage:#0d0b10; --ink:#f6f1ea; --ink-2:#cfc6ba; --ink-3:#8e867c;
  --glass:rgba(18,14,20,.55); --glass-line:rgba(255,240,220,.22);
  --silver:#c9d3e6; --gold:#e3b866; --gold-2:#f3d79b;
  --wood:#46b47f; --fire:#ec5a43; --earth:#d3a13a; --metal:#c9d1dc; --water:#5b8ce6;
  --sans:'Noto Sans KR',"Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  --serif:'Noto Serif KR',"Nanum Myeongjo",serif;
  color-scheme:dark;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);display:flex;justify-content:center;overflow:hidden;word-break:keep-all;overflow-wrap:break-word}
button{font-family:inherit}
.stage{position:relative;width:100%;max-width:460px;height:100%;background:var(--stage);overflow:hidden}
@media (min-width:700px){.stage{height:min(100%,920px);margin-top:auto;margin-bottom:auto;border-radius:22px;box-shadow:0 30px 80px rgba(0,0,0,.6)}}

/* media layers */
.layer{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .28s ease;will-change:opacity;transform:translateZ(0)}
.layer.on{opacity:1}
.poster{position:absolute;inset:0;background:#000 center/cover no-repeat;opacity:0;transition:opacity .6s ease}
.poster.on{opacity:1}
.poster.kb{animation:kb 9s ease-in-out infinite alternate}
@keyframes kb{from{transform:scale(1)}to{transform:scale(1.05)}}
.shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.45) 0%,rgba(0,0,0,0) 18%,rgba(0,0,0,0) 45%,rgba(0,0,0,.55) 72%,rgba(0,0,0,.88) 100%)}

/* top bar */
.top{position:absolute;left:0;right:0;top:0;padding:calc(env(safe-area-inset-top,0px) + 14px) 16px 0;display:flex;justify-content:space-between;align-items:center;z-index:30}
.backB{display:none;align-items:center;gap:4px;height:38px;padding:0 14px 0 8px;border-radius:999px;border:1px solid var(--glass-line);background:var(--glass);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:var(--ink);font-size:14px;font-weight:700;cursor:pointer;font-family:var(--sans)}
.backB svg{width:20px;height:20px}
.stage.subm .brand{display:none}
.stage.subm .backB{display:inline-flex}
.stage.subm .top{z-index:60}
.brand{font-family:var(--serif);font-weight:900;letter-spacing:.18em;font-size:13px;color:var(--gold-2);text-shadow:0 1px 8px rgba(0,0,0,.6)}
.tbtn{width:38px;height:38px;border-radius:50%;border:1px solid var(--glass-line);background:var(--glass);backdrop-filter:blur(8px);color:var(--ink);display:grid;place-items:center;cursor:pointer}
.tbtn svg{width:18px;height:18px}
.tgroup{display:flex;gap:8px}

/* subtitles */
.sub{position:absolute;left:18px;right:18px;top:56%;transform:translateY(-50%);text-align:center;z-index:20;pointer-events:none}
.sub p{margin:0;font-family:var(--serif);font-weight:900;font-size:clamp(26px,7.6vw,34px);line-height:1.32;letter-spacing:-.01em;color:#fff;text-shadow:0 2px 3px rgba(0,0,0,.7),0 0 22px rgba(0,0,0,.65);text-wrap:balance;opacity:0;transform:translateY(8px);transition:opacity .35s ease,transform .35s ease}
.sub p.on{opacity:1;transform:none}
.sub .who{display:block;font-family:var(--sans);font-size:12px;font-weight:700;letter-spacing:.2em;color:var(--gold-2);margin-bottom:10px;text-shadow:0 1px 6px rgba(0,0,0,.8);opacity:0;transition:opacity .3s}
.sub .who.on{opacity:1}

/* bottom panels */
.panel{position:absolute;left:0;right:0;bottom:0;padding:0 16px calc(env(safe-area-inset-bottom,0px) + 22px);z-index:25;display:flex;flex-direction:column;gap:10px;transform:translateY(30px);opacity:0;pointer-events:none;transition:opacity .35s ease,transform .35s ease}
.panel.on{transform:none;opacity:1;pointer-events:auto}
.choice{width:100%;min-height:58px;border-radius:18px;border:1px solid var(--glass-line);background:var(--glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:var(--ink);font-size:17px;font-weight:500;cursor:pointer;padding:14px 18px}
.choice:active{transform:scale(.985)}
.choice.primary{background:linear-gradient(180deg,rgba(227,184,102,.95),rgba(196,146,64,.95));color:#1a1206;border-color:transparent;font-weight:900}
.link{background:none;border:0;color:var(--ink-2);font-size:14px;padding:8px;cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.sheet{border-radius:22px;border:1px solid var(--glass-line);background:rgba(16,12,18,.72);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:18px 16px 16px}
.sheet h3{margin:0 0 12px;font-size:15px;font-weight:700;color:var(--gold-2);letter-spacing:.04em}
.row{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:8px}
.row2{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:8px}
select,input[type=text]{width:100%;height:50px;border-radius:12px;border:1px solid var(--glass-line);background:rgba(0,0,0,.35);color:var(--ink);font-size:16px;font-family:var(--sans);padding:0 12px;appearance:none;-webkit-appearance:none}
select{background-image:linear-gradient(45deg,transparent 50%,var(--ink-2) 50%),linear-gradient(135deg,var(--ink-2) 50%,transparent 50%);background-position:calc(100% - 16px) 22px,calc(100% - 11px) 22px;background-size:5px 5px;background-repeat:no-repeat;padding-right:26px}
select:focus,input:focus,.choice:focus-visible,.chip:focus-visible,.tbtn:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.seg{display:flex;border:1px solid var(--glass-line);border-radius:12px;overflow:hidden;height:50px}
.seg button{flex:1;border:0;background:transparent;color:var(--ink-2);font-size:15px;padding:0 14px;cursor:pointer}
.seg button[aria-pressed=true]{background:rgba(227,184,102,.22);color:var(--gold-2);font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--glass-line);background:rgba(0,0,0,.3);color:var(--ink);border-radius:999px;padding:11px 16px;font-size:15px;cursor:pointer}
.chip[aria-pressed=true]{background:rgba(227,184,102,.25);border-color:var(--gold);color:var(--gold-2);font-weight:700}
.hint{font-size:12px;color:var(--ink-3);margin-top:8px;line-height:1.5}

/* start screen */
.start{position:absolute;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;padding:0 16px calc(env(safe-area-inset-bottom,0px) + 26px);background:linear-gradient(180deg,rgba(7,6,10,.2),rgba(7,6,10,.15) 40%,rgba(7,6,10,.92) 78%);transition:opacity .6s}
.start.off{opacity:0;pointer-events:none}
.start .kicker{font-size:12px;letter-spacing:.3em;color:var(--gold-2);font-weight:700}
.start h1{font-family:var(--serif);font-weight:900;font-size:clamp(26px,7.6vw,34px);line-height:1.18;margin:10px 0 10px;letter-spacing:-.01em}
.start p{margin:0 0 22px;color:var(--ink-2);font-size:15px;line-height:1.6}
.load{margin-top:14px;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;color:var(--ink-3);letter-spacing:.04em}.load .lb{width:120px;height:2px;background:rgba(255,255,255,.12);border-radius:2px;overflow:hidden}.load .lb i{display:block;height:100%;width:0;background:var(--gold-2);transition:width .3s}
.choice:disabled{opacity:.55}
.start .snd{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ink-3);margin-top:12px;justify-content:center}

/* reveal */
.reveal{position:absolute;inset:0;z-index:28;pointer-events:none}
.flash{position:absolute;inset:0;background:radial-gradient(circle at 50% 45%,rgba(255,236,190,.95),rgba(255,236,190,0) 60%);opacity:0}
.flash.go{animation:flash 1.1s ease-out forwards}
@keyframes flash{0%{opacity:0}25%{opacity:1}100%{opacity:0}}
.namecard{position:absolute;left:16px;right:16px;bottom:calc(env(safe-area-inset-bottom,0px) + 26px);border-radius:22px;padding:18px 18px 16px;background:rgba(10,8,12,.62);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--glass-line);transform:translateY(30px);opacity:0;transition:all .6s ease;pointer-events:none}
.namecard.on{transform:none;opacity:1}
.namecard .k{font-size:12px;letter-spacing:.25em;color:var(--gold-2);font-weight:700}
.namecard .n{display:flex;align-items:baseline;gap:10px;margin-top:8px}
.namecard .n b{font-family:var(--serif);font-size:34px;font-weight:900;color:var(--c)}
.namecard .n span{font-size:22px;font-weight:900}
.namecard .d{font-size:14px;color:var(--ink-2);margin-top:4px}

/* partner reading (Sion): webtoon report + paywall */
.report{position:absolute;inset:0;z-index:36;overflow-y:auto;background:#0b0d12;opacity:0;pointer-events:none;transition:opacity .6s;padding:calc(env(safe-area-inset-top,0px) + 62px) 0 calc(env(safe-area-inset-bottom,0px) + 36px)}
.report.on{opacity:1;pointer-events:auto}
.rh{padding:0 18px 16px}
.rh small{display:block;font-size:11px;letter-spacing:.24em;color:var(--silver);font-weight:700}
.rh b{display:block;font-family:var(--serif);font-size:25px;font-weight:900;line-height:1.3;margin-top:6px}
.rh span{display:block;font-size:13px;color:var(--ink-3);margin-top:6px}
.wt{position:relative}
.wt img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;background:#111}
.bub{position:relative;z-index:1;margin:-44px 16px 26px;background:rgba(248,249,252,.97);color:#14161c;border-radius:18px;padding:14px 16px 15px;font-size:16px;line-height:1.6;font-weight:500;box-shadow:0 12px 30px rgba(0,0,0,.45)}
.bub .by{display:block;font-size:11px;font-weight:700;letter-spacing:.18em;color:#5b6475;margin-bottom:4px}
.bub.narr{background:rgba(14,16,22,.9);color:#e8ecf3;border:1px solid rgba(201,211,230,.28)}
.bub b{font-weight:900}
.more{margin:4px 16px 0}
.paywrap{display:none}
.paywrap.on{display:block}
.wt.lock img{filter:blur(16px) brightness(.55)}
.pay{position:relative;z-index:2;margin:-150px 16px 0;border-radius:22px;border:1px solid rgba(201,211,230,.35);background:rgba(14,16,22,.93);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:20px 18px 18px}
.pay .k{font-size:11px;letter-spacing:.22em;color:var(--silver);font-weight:700}
.pay h4{margin:6px 0 12px;font-family:var(--serif);font-size:22px;font-weight:900;line-height:1.35}
.pay ol{list-style:none;margin:0 0 16px;padding:0;display:grid;gap:8px}
.pay li{display:flex;gap:10px;align-items:center;font-size:15px;color:var(--ink);padding:11px 12px;border-radius:12px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)}
.pay li i{font-style:normal;opacity:.8}
.pay .price{display:flex;align-items:baseline;gap:8px;margin:0 0 12px}
.pay .price s{color:var(--ink-3);font-size:14px}
.pay .price b{font-size:26px;font-weight:900}
.choice.silver{background:linear-gradient(180deg,#e9edf5,#b9c3d6);color:#10131a;border:0;font-weight:800}
/* membership demo: permission, next-morning, lock screen push, mission, gauge, subscribe */
.ov{position:absolute;inset:0;z-index:50;opacity:0;pointer-events:none;transition:opacity .5s}
.ov.on{opacity:1;pointer-events:auto}
.prePerm{display:flex;flex-direction:column;justify-content:flex-end;padding:0 16px calc(env(safe-area-inset-bottom,0px) + 22px);background:rgba(0,0,0,.55)}
.prePerm .sheet{text-align:center}
.prePerm .av{width:72px;height:72px;border-radius:50%;margin:0 auto 12px;background:#000 center 20%/cover;border:2px solid var(--gold)}
.prePerm p{margin:0 0 14px;font-family:var(--serif);font-size:19px;font-weight:700;line-height:1.5}
.sysA{display:grid;place-items:center;background:rgba(0,0,0,.35)}
.sysA .box{width:272px;border-radius:14px;background:rgba(242,242,247,.96);color:#111;text-align:center;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,var(--sans)}
.sysA .box b{display:block;padding:18px 16px 4px;font-size:16.5px;line-height:1.3}
.sysA .box span{display:block;padding:0 16px 16px;font-size:13px;line-height:1.4;color:#333}
.sysA .btns{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(0,0,0,.15)}
.sysA .btns button{border:0;background:none;height:44px;font-size:16.5px;color:#0a64d8;cursor:pointer}
.sysA .btns button+button{border-left:1px solid rgba(0,0,0,.15);font-weight:600}
.night{display:grid;place-items:center;background:#000;text-align:center}
.night small{display:block;font-size:12px;letter-spacing:.3em;color:var(--ink-3)}
.night b{display:block;font-family:var(--serif);font-size:40px;font-weight:900;margin-top:8px}
.lockS{background:#0c0c10 center/cover no-repeat;color:#fff;font-family:-apple-system,BlinkMacSystemFont,var(--sans)}
.lockS::before{content:"";position:absolute;inset:0;backdrop-filter:blur(18px) brightness(.7);-webkit-backdrop-filter:blur(18px) brightness(.7)}
.lockS .in{position:relative;padding:calc(env(safe-area-inset-top,0px) + 70px) 12px 0;text-align:center}
.lockS .dt{font-size:17px;font-weight:600;opacity:.9}
.lockS .tm{font-size:84px;font-weight:700;line-height:1;margin:4px 0 26px;letter-spacing:-.02em}
.noti{display:flex;gap:11px;align-items:center;text-align:left;padding:12px 13px;border-radius:20px;background:rgba(245,245,250,.2);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);cursor:pointer;transform:translateY(-14px);opacity:0;transition:all .5s cubic-bezier(.2,.8,.2,1)}
.noti.on{transform:none;opacity:1}
.noti .pic{position:relative;flex:none;width:42px;height:42px;border-radius:50%;background:#000 center 20%/cover}
.noti .pic i{position:absolute;right:-3px;bottom:-3px;width:18px;height:18px;border-radius:5px;background:#16121a;border:1.5px solid rgba(255,255,255,.9);display:grid;place-items:center;font-style:normal;font-family:var(--serif);font-size:10px;font-weight:900;color:var(--gold)}
.noti .tx{flex:1;min-width:0}
.noti .tx .r1{display:flex;justify-content:space-between;font-size:14.5px}
.noti .tx .r1 b{font-weight:700}
.noti .tx .r1 span{opacity:.7;font-size:13px}
.noti .tx p{margin:2px 0 0;font-size:14.5px;line-height:1.35;opacity:.95}
.lockS .hint2{position:absolute;left:0;right:0;bottom:calc(env(safe-area-inset-bottom,0px) + 30px);text-align:center;font-size:13px;opacity:.75}
.mcard .k{font-size:12px;color:var(--gold-2);font-weight:700;letter-spacing:.08em}
.mcard p{margin:8px 0 14px;font-family:var(--serif);font-size:21px;font-weight:900;line-height:1.5}
.gaugeS,.subS{overflow-y:auto;background:linear-gradient(180deg,#120e14,#09070b);padding:calc(env(safe-area-inset-top,0px) + 64px) 16px calc(env(safe-area-inset-bottom,0px) + 28px)}
.gH small{display:block;font-size:11px;letter-spacing:.24em;color:var(--gold-2);font-weight:700}
.gH b{display:block;font-family:var(--serif);font-size:26px;font-weight:900;line-height:1.35;margin-top:6px}
.gBox{margin-top:16px;border-radius:20px;border:1px solid var(--glass-line);background:#141016;padding:16px}
.gBox h4{margin:0 0 12px;font-size:12px;letter-spacing:.2em;color:var(--ink-3);font-weight:700}
.gBars .bar i{transition:width 1.4s cubic-bezier(.2,.8,.2,1)}
.gUp{display:inline-block;margin-left:6px;font-size:12px;font-weight:800;color:var(--gold-2);opacity:0;transform:translateY(4px);transition:all .5s .9s}
.gUp.on{opacity:1;transform:none}
.streak{display:flex;gap:6px;margin-top:4px}
.streak span{flex:1;height:34px;border-radius:10px;border:1px solid var(--glass-line);display:grid;place-items:center;font-size:12px;color:var(--ink-3)}
.streak span.on{background:rgba(227,184,102,.22);border-color:var(--gold);color:var(--gold-2);font-weight:800}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;font-size:12px;text-align:center}
.cal .w{color:var(--ink-3);font-size:11px}
.cal .d{aspect-ratio:1;border-radius:9px;display:grid;place-items:center;background:rgba(255,255,255,.04);color:var(--ink-2)}
.cal .d.t{border:1px solid var(--gold);color:var(--gold-2);font-weight:800}
.cal .d.k{background:rgba(227,184,102,.2);color:var(--gold-2);font-weight:800;position:relative}
.cal .d.k::after{content:"🔒";position:absolute;right:-2px;top:-5px;font-size:10px}
.keyday{margin-top:12px;display:grid;gap:8px}
.keyday div{display:flex;justify-content:space-between;align-items:center;padding:11px 12px;border-radius:12px;background:rgba(255,255,255,.05);font-size:14px}
.keyday div em{font-style:normal;filter:blur(4px);color:var(--ink-2)}
.subList{list-style:none;margin:14px 0 18px;padding:0;display:grid;gap:9px}
.subList li{display:flex;gap:10px;align-items:flex-start;font-size:15px;line-height:1.45;padding:12px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)}
.subList li i{font-style:normal;flex:none}
.subPrice{display:flex;align-items:baseline;gap:8px;margin-bottom:12px}
.subPrice b{font-size:28px;font-weight:900}.subPrice span{color:var(--ink-3);font-size:14px}
/* main home (poster-led, black) */
.stage.homeMode .top{display:none}
.home{position:absolute;inset:0;z-index:44;overflow-y:auto;background:#000;opacity:0;pointer-events:none;transition:opacity .5s;padding-bottom:calc(env(safe-area-inset-bottom,0px) + 110px);scrollbar-width:none}
.home::-webkit-scrollbar{display:none}
.home.on{opacity:1;pointer-events:auto}
.hHead{position:sticky;top:0;z-index:5;background:#000;padding:calc(env(safe-area-inset-top,0px) + 12px) 16px 4px}
.hHead::after{content:"";position:absolute;left:0;right:0;top:100%;height:18px;background:linear-gradient(180deg,#000,rgba(0,0,0,0));pointer-events:none}
.hBar{display:flex;justify-content:space-between;align-items:center;height:40px}
.logo{display:flex;align-items:baseline;gap:7px}
.logo b{font-family:var(--serif);font-size:25px;font-weight:900;letter-spacing:-.02em;background:linear-gradient(180deg,#f6dea6,#c99a45);-webkit-background-clip:text;background-clip:text;color:transparent}
.logo i{font-style:normal;display:flex;gap:3px}
.logo i u{width:6px;height:6px;border-radius:50%;background:var(--c)}
.hIc{display:flex;gap:6px}
.hIc button{width:38px;height:38px;border:0;background:none;color:#fff;display:grid;place-items:center;cursor:pointer}
.hIc svg{width:23px;height:23px}
.pills{display:flex;gap:4px;overflow-x:auto;padding:8px 0 6px;scrollbar-width:none}
.pills::-webkit-scrollbar{display:none}
.pills button{flex:none;border:0;background:none;color:#9a9aa2;font-size:16px;font-weight:500;padding:9px 15px;border-radius:999px;cursor:pointer;font-family:var(--sans)}
.pills button.on{color:#fff;font-weight:800;background:rgba(255,255,255,.1);box-shadow:inset 0 0 0 1px rgba(255,255,255,.16)}
.today{margin:10px 16px 0;border-radius:24px;background:#111013;border:1px solid rgba(227,184,102,.28);padding:16px;cursor:pointer}
.today .r{display:flex;gap:13px;align-items:center}
.today .av{flex:none;width:58px;height:58px;border-radius:50%;background:#000 center 20%/cover;box-shadow:0 0 0 2px #111013,0 0 0 4px var(--c)}
.today small{display:block;font-size:12.5px;color:#9a9aa2}
.today small em{font-style:normal;color:var(--c);font-weight:800}
.today p{margin:4px 0 0;font-size:16.5px;font-weight:800;line-height:1.4;color:#fff}
.today .go{flex:none;align-self:center;font-size:13px;font-weight:800;color:#15110a;background:var(--gold);border-radius:999px;padding:9px 13px}
.hG{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:14px}
.hG div{text-align:center}
.hG div b{display:block;font-family:var(--serif);font-size:15px;color:var(--c);font-weight:900}
.hG div i{display:block;height:4px;border-radius:2px;background:rgba(255,255,255,.08);margin-top:5px;overflow:hidden}
.hG div i::after{content:"";display:block;height:100%;width:var(--w);background:var(--c)}
.hG div.low b::after{content:" 채울 차례";font-family:var(--sans);font-size:9.5px;font-weight:700;color:#9a9aa2;display:block}
.hSec{margin-top:40px}
.hSec[hidden]{display:none}
.sh{padding:0 16px 14px}
.sh small{display:block;font-size:13.5px;color:#8a8a92;font-weight:500}
.sh b{display:block;font-size:22px;font-weight:800;letter-spacing:-.02em;color:#fff;margin-top:4px}
.hRow{display:flex;gap:12px;overflow-x:auto;padding:0 16px;scroll-snap-type:x mandatory;scrollbar-width:none;scroll-padding:0 16px}
.hRow::-webkit-scrollbar{display:none}
.pc{flex:none;width:78%;max-width:330px;aspect-ratio:2/3;border-radius:22px;overflow:hidden;position:relative;scroll-snap-align:start;background:#111 center 22%/cover no-repeat;cursor:pointer}
.pc::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 38%,rgba(0,0,0,.35) 58%,rgba(0,0,0,.88) 100%)}
.pc .ct{position:absolute;left:0;right:0;bottom:26px;text-align:center;padding:0 16px}
.pc .yr{display:block;font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:700;font-size:34px;line-height:.8;color:#fff;letter-spacing:-.02em;text-shadow:0 2px 12px rgba(0,0,0,.5)}
.pc .tt{display:block;font-family:var(--serif);font-weight:900;font-size:38px;line-height:1.15;color:#fff;letter-spacing:-.03em;text-shadow:0 2px 16px rgba(0,0,0,.55)}
.pc .st{display:block;font-family:var(--serif);font-weight:600;font-size:16px;color:rgba(255,255,255,.92);margin-top:10px;text-shadow:0 1px 8px rgba(0,0,0,.6)}
.pc .chip{position:absolute;top:14px;left:14px;font-size:11.5px;font-weight:800;border-radius:999px;padding:6px 10px;background:rgba(0,0,0,.45);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#fff;border:1px solid rgba(255,255,255,.18)}
.pc .chip.open{background:var(--gold);color:#15110a;border:0}
.pc .play{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,.45);backdrop-filter:blur(8px);display:grid;place-items:center;border:1px solid rgba(255,255,255,.2)}
.pc .play::after{content:"";margin-left:3px;border-left:10px solid #fff;border-top:6px solid transparent;border-bottom:6px solid transparent}
.oRow{display:flex;gap:14px;overflow-x:auto;padding:0 16px;scrollbar-width:none}
.oRow::-webkit-scrollbar{display:none}
.om{flex:none;width:70px;text-align:center;cursor:pointer;background:none;border:0;color:#fff;padding:0}
.om span{display:block;width:66px;height:66px;margin:3px auto 0;border-radius:50%;background:#000 center 18%/cover;box-shadow:0 0 0 2px #000,0 0 0 4px var(--c)}
.om b{display:block;font-size:14px;font-weight:800;margin-top:10px}
.om small{display:block;font-size:11.5px;color:#8a8a92;margin-top:1px}
.om.mine b::after{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--gold);margin-left:4px;vertical-align:middle}
.tool{margin:0 16px 12px;border-radius:24px;background:#141414;padding:22px 20px;display:flex;justify-content:space-between;align-items:center;gap:12px;cursor:pointer}
.tool b{display:block;font-size:21px;font-weight:800;letter-spacing:-.02em}
.tool small{display:block;font-size:14px;color:#8a8a92;margin-top:6px;line-height:1.5}
.tool small em{font-style:normal;color:var(--gold-2)}
.tiles{flex:none;display:grid;grid-template-columns:repeat(2,44px);gap:7px}
.tiles span{width:44px;height:44px;border-radius:13px;background:#1f1f22;display:grid;place-items:center;font-family:var(--serif);font-weight:900;font-size:18px;color:var(--c)}
.ring{flex:none;width:78px;height:78px;border-radius:50%;border:2px dashed rgba(227,184,102,.45);display:grid;place-items:center;font-family:var(--serif);font-size:30px;font-weight:900;color:var(--gold-2)}
.rank{padding:0 16px;display:grid;gap:18px}
.rk{display:grid;grid-template-columns:132px 26px 1fr;gap:10px;align-items:center;cursor:pointer}
.rk span.th{width:132px;height:86px;border-radius:18px;background:#111 center 25%/cover}
.rk em{font-style:normal;font-size:22px;font-weight:800;text-align:center}
.rk b{display:block;font-size:17px;font-weight:800;letter-spacing:-.02em}
.rk small{display:block;font-size:13.5px;color:#8a8a92;margin-top:4px}
.rv{padding:0 16px;display:grid;gap:26px}
.rv .h{display:flex;align-items:center;gap:12px}
.rv .h .a{flex:none;width:46px;height:46px;border-radius:50%;background:#1a1a1d;display:grid;place-items:center;font-family:var(--serif);font-weight:900;font-size:19px;color:var(--c)}
.rv .h b{font-size:14.5px;font-weight:700}
.rv .h small{display:block;color:#f5c542;font-size:13px;letter-spacing:1px;margin-top:2px}
.rv .h time{margin-left:auto;font-size:12.5px;color:#8a8a92}
.rv p{margin:12px 0 12px;font-size:15px;line-height:1.7;color:#e6e6ea}
.rv .lk{display:flex;align-items:center;gap:12px;border:1px solid #2a2a2e;border-radius:18px;padding:12px 14px;cursor:pointer}
.rv .lk span{flex:none;width:52px;height:52px;border-radius:12px;background:#111 center 25%/cover}
.rv .lk b{display:block;font-size:15px;font-weight:800}
.rv .lk small{display:block;font-size:12.5px;color:#8a8a92;margin-top:2px}
.rv .lk::after{content:"›";margin-left:auto;font-size:22px;color:#8a8a92}
.hFoot{margin:44px 16px 0;padding-top:18px;border-top:1px solid #1d1d20;font-size:11.5px;line-height:1.8;color:#5d5d63}
.tabs{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(env(safe-area-inset-bottom,0px) + 14px);z-index:46;width:min(92%,380px);display:grid;grid-template-columns:repeat(5,1fr);padding:6px;border-radius:999px;background:rgba(28,28,32,.72);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);border:1px solid rgba(255,255,255,.1);opacity:0;pointer-events:none;transition:opacity .5s}
.tabs.on{opacity:1;pointer-events:auto}
.tabs button{border:0;background:none;color:#8a8a92;font-size:10.5px;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;padding:7px 0 6px;border-radius:999px;font-family:var(--sans)}
.tabs button svg{width:22px;height:22px}
.tabs button.on{color:#fff;font-weight:700;background:rgba(255,255,255,.12)}
.toTop{position:absolute;right:18px;bottom:calc(env(safe-area-inset-bottom,0px) + 90px);z-index:46;width:46px;height:46px;border-radius:50%;border:0;background:#fff;color:#000;display:grid;place-items:center;box-shadow:0 6px 20px rgba(0,0,0,.5);opacity:0;pointer-events:none;transition:opacity .3s;cursor:pointer}
.toTop.on{opacity:1;pointer-events:auto}
.kvm{display:flex;flex-direction:column;justify-content:flex-end;background:rgba(0,0,0,.6);z-index:52}
.kvm .box{border-radius:26px 26px 0 0;background:#111013;border-top:1px solid rgba(227,184,102,.3);max-height:88%;overflow-y:auto;padding-bottom:calc(env(safe-area-inset-bottom,0px) + 18px)}
.kvm img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center 25%}
.kvm .in{padding:18px 18px 0}
.kvm small{font-size:11px;letter-spacing:.2em;color:var(--gold-2);font-weight:700}
.kvm b{display:block;font-family:var(--serif);font-size:26px;font-weight:900;line-height:1.3;margin:6px 0 8px}
.kvm p{margin:0 0 16px;font-size:14.5px;line-height:1.7;color:var(--ink-2)}
.homeLink{display:block;margin:10px auto 0}
/* result */
.result{position:absolute;inset:0;z-index:35;overflow-y:auto;background:linear-gradient(180deg,#120e14,#09070b);opacity:0;pointer-events:none;transition:opacity .6s;padding:calc(env(safe-area-inset-top,0px) + 64px) 16px calc(env(safe-area-inset-bottom,0px) + 28px)}
.result.on{opacity:1;pointer-events:auto}
.card{border-radius:24px;overflow:hidden;border:1px solid rgba(227,184,102,.35);background:#141016;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.card .hero{position:relative;aspect-ratio:4/5;background:#000 center 18%/cover no-repeat}
.card .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 45%,rgba(20,16,22,1) 100%)}
.card .hero .tag{position:absolute;left:16px;top:16px;z-index:1;font-size:11px;letter-spacing:.24em;font-weight:700;color:#1a1206;background:var(--gold);padding:5px 10px;border-radius:999px}
.card .hero .nm{position:absolute;left:18px;bottom:14px;z-index:1}
.card .hero .nm small{display:block;font-size:12px;color:var(--gold-2);letter-spacing:.2em;font-weight:700}
.card .hero .nm b{font-family:var(--serif);font-size:30px;font-weight:900}
.card .body{padding:6px 18px 20px}
.sec{margin-top:18px}
.sec h4{margin:0 0 10px;font-size:12px;letter-spacing:.2em;color:var(--ink-3);font-weight:700}
.pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;text-align:center}
.pillars div{border-radius:12px;background:rgba(255,255,255,.04);padding:8px 0 6px}
.pillars .l{font-size:11px;color:var(--ink-3)}
.pillars .c{font-family:var(--serif);font-size:24px;font-weight:900;line-height:1.25}
.bars{display:grid;gap:8px}
.bar{display:grid;grid-template-columns:44px 1fr 22px;gap:10px;align-items:center;font-size:13px}
.bar .t{height:10px;border-radius:6px;background:rgba(255,255,255,.07);overflow:hidden}
.bar .t i{display:block;height:100%;border-radius:6px;background:var(--c);width:0;transition:width 1s ease .3s}
.bar .v{text-align:right;color:var(--ink-2);font-variant-numeric:tabular-nums}
.bar.low .lbl{color:var(--c);font-weight:900}
.mission{border-radius:16px;padding:14px 16px;background:rgba(227,184,102,.1);border:1px solid rgba(227,184,102,.3)}
.mission .k{font-size:12px;color:var(--gold-2);font-weight:700;letter-spacing:.06em}
.mission p{margin:6px 0 0;font-family:var(--serif);font-size:18px;font-weight:700;line-height:1.5;filter:blur(4px);user-select:none}
.mission .lock{font-size:12px;color:var(--ink-3);margin-top:8px}
.actions{display:grid;gap:10px;margin-top:18px}
.note{font-size:11.5px;color:var(--ink-3);text-align:center;margin-top:14px;line-height:1.5}
.toast{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 90px);transform:translateX(-50%);z-index:60;background:rgba(0,0,0,.8);color:#fff;font-size:14px;padding:10px 16px;border-radius:999px;opacity:0;transition:opacity .3s;pointer-events:none;white-space:nowrap}
.toast.on{opacity:1}
@media (prefers-reduced-motion:reduce){.poster.kb{animation:none}.layer,.poster,.panel,.sub p{transition:none}}
</style>

<div class="stage" id="stage">
  <div class="poster kb" id="poster"></div>
  <video class="layer" id="vA" playsinline webkit-playsinline preload="auto"></video>
  <video class="layer" id="vB" playsinline webkit-playsinline preload="auto"></video>
  <div class="shade"></div>

  <div class="top">
    <div class="brand">SEOHA · SALON</div>
    <button class="backB" id="backBtn" aria-label="홈으로 돌아가기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 5l-7 7 7 7"/></svg>홈</button>
    <div class="tgroup">
      <button class="tbtn" id="muteBtn" aria-label="소리 끄기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 5 6 9H3v6h3l5 4V5z"/><path id="waves" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg></button>
      <button class="tbtn" id="restartBtn" aria-label="처음부터"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg></button>
    </div>
  </div>

  <div class="sub" id="sub" aria-live="polite"><span class="who" id="who">서하</span><div id="subLines"></div></div>

  <!-- choices after line 1 -->
  <div class="panel" id="pChoice">
    <button class="choice" id="c1a">(여기 어디지…?)</button>
    <button class="choice" id="c1b">네… (조심스럽게 앉는다)</button>
  </div>

  <!-- birth form -->
  <div class="panel" id="pBirth">
    <div class="sheet">
      <h3>생년월일 · 태어난 시간</h3>
      <div class="row">
        <select id="by" aria-label="태어난 해"></select>
        <select id="bm" aria-label="태어난 달"></select>
        <select id="bd" aria-label="태어난 날"></select>
      </div>
      <div class="row2">
        <select id="bh" aria-label="태어난 시간"></select>
        <div class="seg" role="group" aria-label="양력 음력"><button id="solar" aria-pressed="true">양력</button><button id="lunar" aria-pressed="false">음력</button></div>
      </div>
      <p class="hint">체험판은 입력값으로 간이 명식을 계산합니다. 음력 변환은 정식 버전에서 지원합니다.</p>
    </div>
    <button class="choice primary" id="birthGo">알려주기</button>
  </div>

  <!-- worry -->
  <div class="panel" id="pWorry">
    <div class="sheet">
      <h3>누구 때문에 왔어?</h3>
      <div class="chips" id="chips">
        <button class="chip" aria-pressed="false">그 사람 마음</button>
        <button class="chip" aria-pressed="false">재회</button>
        <button class="chip" aria-pressed="false">새 인연</button>
        <button class="chip" aria-pressed="false">일 · 이직</button>
      </div>
      <input type="text" id="worryText" placeholder="직접 말하기 (선택)" style="margin-top:10px" maxlength="60">
    </div>
    <button class="choice primary" id="worryGo">말하기</button>
    <button class="link" id="worrySkip">아니, 그냥 (건너뛰기)</button>
  </div>

  <div class="reveal" id="reveal"><div class="flash" id="flash"></div>
    <div class="namecard" id="namecard"><div class="k">나의 수호신</div><div class="n"><b id="ncHanja"></b><span id="ncName"></span></div><div class="d" id="ncDesc"></div></div>
  </div>

  <div class="result" id="result">
    <div class="card">
      <div class="hero" id="rHero"><span class="tag">나의 수호신 카드</span><div class="nm"><small id="rGod"></small><b id="rName"></b></div></div>
      <div class="body">
        <div class="sec"><h4>나의 명식</h4><div class="pillars" id="rPillars"></div></div>
        <div class="sec"><h4>오행 밸런스</h4><div class="bars" id="rBars"></div></div>
        <div class="sec"><div class="mission"><div class="k">내일 08:00 · 첫 개운 미션</div><p id="rMission"></p><div class="lock">알림을 켜면 아침에 열립니다</div></div></div>
        <div class="actions">
          <button class="choice silver" id="ctaPartner" style="order:-1">그 사람 속마음, 시온한테 물어보기</button>
          <button class="choice" id="ctaPay">서하의 상담 이어서 보기 · 29,000원</button>
          <button class="choice primary" id="ctaPush">내일 아침 첫 미션 받기</button>
          <button class="choice" id="ctaShare">수호신 카드 공유하기</button>
          <button class="link homeLink" id="ctaHome">홈으로 가기 →</button>
        </div>
        <p class="note">체험판입니다. 결제·알림·공유는 동작하지 않습니다.</p>
      </div>
    </div>
  </div>

  <div class="start" id="start">
    <div class="kicker">한남동 · 이름 없는 살롱</div>
    <h1>네 사주에 없는 기운,<br>신이 채워줄게.</h1>
    <p>문 너머에서 누군가 기다리고 있다.</p>
    <button class="choice primary" id="enter">안으로 들어가기</button>
    <button class="link" id="skipStory">스토리 건너뛰기</button>
    <button class="link" id="goHome" style="font-size:12.5px;color:var(--ink-3)">이미 수호신이 있어요 · 홈으로</button>
    <div class="snd">🔊 소리를 켜고 들어가세요</div>
    <div class="load"><div class="lb"><i id="loadbar"></i></div><span id="loadtxt">영상 준비 중 0%</span></div>
  </div>

  <!-- partner input (Sion) -->
  <div class="panel" id="pPartner">
    <div class="sheet">
      <h3 style="color:var(--silver)">그 사람 생년월일</h3>
      <div class="row"><select id="py" aria-label="그 사람 태어난 해"></select><select id="pm" aria-label="그 사람 태어난 달"></select><select id="pd" aria-label="그 사람 태어난 날"></select></div>
      <h3 style="color:var(--silver);margin-top:14px">지금 둘은?</h3>
      <div class="chips" id="pchips"><button class="chip" aria-pressed="true">연락 끊김</button><button class="chip" aria-pressed="false">썸</button><button class="chip" aria-pressed="false">연애 중</button><button class="chip" aria-pressed="false">헤어짐</button></div>
    </div>
    <button class="choice silver" id="partnerGo">시온, 보여줘</button>
  </div>

  <div class="report" id="report" aria-live="polite">
    <div class="rh"><small>시온의 은거울 · 그 사람의 요즘</small><b id="rpTitle"></b><span id="rpSub"></span></div>
    <div class="wt"><img src="img/w1.jpg" alt="은거울에 비친 그 사람의 실루엣"></div>
    <div class="bub"><span class="by">시온</span><span id="b1"></span></div>
    <div class="wt"><img src="img/w2.jpg" alt="밤에 혼자 휴대폰을 보는 그 사람"></div>
    <div class="bub narr"><span id="b2"></span></div>
    <div class="wt"><img src="img/w3.jpg" alt="전송 버튼 위에서 멈춘 엄지"></div>
    <div class="bub narr"><span id="b3"></span></div>
    <div class="more" id="moreWrap"><button class="choice silver" id="rpMore">그래서, 그 사람 진짜 속마음은?</button></div>
    <div class="paywrap" id="payWrap">
      <div class="wt lock"><img src="img/w4.jpg" alt=""></div>
      <div class="pay">
        <div class="k">그 사람 속마음 리포트</div>
        <h4 id="payTitle">그 사람이 먼저 연락할 시기,<br>시온은 이미 봤어.</h4>
        <ol>
          <li><i>🔒</i>그 사람 속마음 전문</li>
          <li><i>🔒</i>다시 연락이 닿는 시기 (월 단위)</li>
          <li><i>🔒</i>둘의 12개월 흐름</li>
          <li><i>🔒</i>시온의 개운 처방 · 먼저 연락해도 되는 날</li>
        </ol>
        <div class="price"><s>39,000원</s><b>29,000원</b></div>
        <button class="choice silver" id="payGo">시온의 리포트 열기</button>
        <p class="note">체험판입니다. 결제되지 않습니다.</p>
        <button class="link homeLink" data-home="1">홈으로</button>
      </div>
    </div>
  </div>

  <!-- membership demo -->
  <div class="ov prePerm" id="ovPre"><div class="sheet"><div class="av" id="preAv"></div><p id="preTx"></p><button class="choice primary" id="preYes">알림 받기</button><button class="link" id="preNo">다음에</button></div></div>
  <div class="ov sysA" id="ovSys"><div class="box"><b>'오방'에서 알림을 보내고자 합니다</b><span>경고, 사운드 및 아이콘 배지가 알림에 포함될 수 있습니다. 설정에서 이를 구성할 수 있습니다.</span><div class="btns"><button id="sysNo">허용 안 함</button><button id="sysYes">허용</button></div></div></div>
  <div class="ov night" id="ovNight"><div><small>다음 날</small><b id="nightT">07:59</b></div></div>
  <div class="ov lockS" id="ovLock"><div class="in"><div class="dt" id="lockD"></div><div class="tm">8:00</div>
    <div class="noti" id="noti" role="button" tabindex="0"><div class="pic" id="notiPic"><i>五</i></div><div class="tx"><div class="r1"><b id="notiN"></b><span>지금</span></div><p id="notiM"></p></div></div></div>
    <div class="hint2">알림을 눌러보세요</div></div>
  <div class="panel" id="pMission"><div class="sheet mcard"><div class="k" id="mK"></div><p id="mTx"></p><button class="choice primary" id="mDone">완료했어</button></div><button class="link" id="mLater">나중에 할게</button></div>
  <div class="ov gaugeS" id="ovGauge">
