  <!-- main home -->
  <div class="home" id="home">
    <div class="hHead">
      <div class="hBar"><div class="logo"><b>오방</b><i><u style="--c:var(--wood)"></u><u style="--c:var(--fire)"></u><u style="--c:var(--earth)"></u><u style="--c:var(--metal)"></u><u style="--c:var(--water)"></u></i></div>
        <div class="hIc"><button id="hBell" aria-label="알림"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg></button><button id="hMenu" aria-label="메뉴"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button></div></div>
      <div class="pills" id="pills"><button class="on" data-c="all">전체</button><button data-c="love">연애</button><button data-c="re">재회</button><button data-c="heart">속마음</button><button data-c="gaeun">개운</button><button data-c="match">궁합</button></div>
    </div>

    <div class="today" id="hMis" role="button" tabindex="0" data-cats="all gaeun">
      <div class="r"><div class="av" id="hMisAv"></div><div style="flex:1;min-width:0"><small id="hMisK"></small><p id="hMisT"></p></div><span class="go">미션 받기</span></div>
