  <button class="toTop" id="toTop" aria-label="맨 위로"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 15l6-6 6 6"/></svg></button>
  <nav class="tabs" id="tabs" aria-label="메인 메뉴">
    <button class="on" data-t="home"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3 3 10.5V21h6v-6h6v6h6V10.5z"/></svg>홈</button>
    <button data-t="cns"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>상담</button>
    <button data-t="mission"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/></svg>미션</button>
    <button data-t="mem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 3a4.5 4.5 0 0 1 0 9 4.5 4.5 0 0 0 0 9"/></svg>오방</button>
    <button data-t="box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/></svg>보관함</button>
  </nav>
  <div class="ov kvm" id="ovKv"><div class="box"><img id="kvImg" alt=""><div class="in"><small id="kvK"></small><b id="kvT"></b><p id="kvP"></p><button class="choice primary" id="kvGo"></button><button class="link homeLink" id="kvClose">닫기</button></div></div></div>

  <div class="toast" id="toast"></div>
</div>

<script>
(()=>{
const $=id=>document.getElementById(id);
const HOST=/*HOST*/{id:'seoha',name:'서하',intro:'v/intro.mp4',introPoster:'img/intro0.jpg',kicker:'한남동 · 이름 없는 살롱',lead:'문 너머에서 누군가 기다리고 있다.',title:'서하의 살롱 체험판',brand:'SEOHA · SALON',clips:'v/',poster:'img/seoha.jpg',
  c1a:'(여기 어디지…?)',c1b:'네… (조심스럽게 앉는다)',worry:'누구 때문에 왔어?',pay:'서하의 상담 이어서 보기 · 29,000원',
  lines:{t1:['왔네.','문 닫고, 이리 와 앉아.'],t1a:['사주 보는 데야.','긴장 풀어. 안 잡아먹어.'],t1b:['말 잘 듣네.','그런 애가 운도 잘 풀려.'],
    t2:['생년월일이랑 태어난 시간.','모르면 모른다고 해.'],t3:['흠…','너 요즘 혼자 참는 거 많지.','얼굴에 다 써 있어.'],t4:['그래서.','누구 때문에 왔어?'],
    t5:['네 사주에 빠진 기운이 하나 있네.','그걸 채워줄 애를 붙여줄게.'],t6:['내일 아침 여덟 시,','그 아이가 첫 개운 미션을 보낼 거야.','알림 켜 둬.']},
  dur:{t1:3.6,t1a:4.9,t1b:4.4,t2:4.6,t3:5.6,t4:3.2,t5:6.3,t6:6.5}}/*/HOST*/;
const H=HOST.clips;
const V={intro:HOST.intro,t1:H+'t1.mp4',t1a:H+'t1a.mp4',t1b:H+'t1b.mp4',t2:H+'t2.mp4',t3:H+'t3.mp4',t4:H+'t4.mp4',t5:H+'t5.mp4',t6:H+'t6.mp4',idle:H+'idle.mp4',
  rv_wood:'v/rv_wood.mp4',rv_fire:'v/rv_fire.mp4',rv_earth:'v/rv_earth.mp4',rv_metal:'v/rv_metal.mp4',rv_water:'v/rv_water.mp4'};
const LINES=HOST.lines;
const FALLBACK_DUR=Object.assign({intro:6,idle:5,rv:5},HOST.dur);
const POSTER={host:HOST.poster};
// host-specific copy
document.title=HOST.title; document.querySelector('.brand').textContent=HOST.brand; $('who').textContent=HOST.name;
$('c1a').textContent=HOST.c1a; $('c1b').textContent=HOST.c1b; document.querySelector('#pWorry h3').textContent=HOST.worry; $('ctaPay').textContent=HOST.pay; document.querySelector('.start .kicker').textContent=HOST.kicker; document.querySelector('.start p').textContent=HOST.lead;
const GODS={
  wood:{h:'靑龍',n:'하람',el:'木',dir:'동쪽',c:'var(--wood)',label:'목(木)',desc:'동쪽을 지키는 청룡 · 새 시작과 다음 인연',mission:'초록색 하나 걸치고, 동쪽으로 딱 10분만 걸어.'},
  fire:{h:'朱雀',n:'이안',el:'火',dir:'남쪽',c:'var(--fire)',label:'화(火)',desc:'남쪽을 지키는 주작 · 고백과 결단',mission:'오늘은 네가 먼저 연락해. 망설이면 불 꺼진다.'},
  earth:{h:'黃龍',n:'도준',el:'土',dir:'중앙',c:'var(--earth)',label:'토(土)',desc:'중앙을 지키는 황룡 · 안정과 관계',mission:'책상 위 하나만 정리하자. 네 자리가 단단해야 운이 앉아.'},
  metal:{h:'白虎',n:'시온',el:'金',dir:'서쪽',c:'var(--metal)',label:'금(金)',desc:'서쪽을 지키는 백호 · 정리와 결단',mission:'오늘, 안 맞는 약속 하나 끊어. 비워야 들어와.'},
  water:{h:'玄武',n:'재이',el:'水',dir:'북쪽',c:'var(--water)',label:'수(水)',desc:'북쪽을 지키는 현무 · 속마음과 지혜',mission:'물 한 잔 먼저 마셔. 그리고 오늘 하루, 세 줄만 적어.'}};
const ORDER=['wood','fire','earth','metal','water'];

/* ---------- saju (simplified solar calc) ---------- */
const STEM='甲乙丙丁戊己庚辛壬癸', BR='子丑寅卯辰巳午未申酉戌亥';
const STEM_EL=[0,0,1,1,2,2,3,3,4,4], BR_EL=[4,2,0,0,2,1,1,2,3,3,2,4];
const EL_KEYS=ORDER, EL_COL=['var(--wood)','var(--fire)','var(--earth)','var(--metal)','var(--water)'];
function jdn(y,m,d){const a=Math.floor((14-m)/12),yy=y+4800-a,mm=m+12*a-3;return d+Math.floor((153*mm+2)/5)+365*yy+Math.floor(yy/4)-Math.floor(yy/100)+Math.floor(yy/400)-32045}
const TERMS=[[2,4],[3,6],[4,5],[5,6],[6,6],[7,7],[8,8],[9,8],[10,8],[11,7],[12,7],[1,6]];
function calc(y,m,d,hBr){
  let sy=y; if(m<2||(m===2&&d<4)) sy=y-1;
  const ys=((sy-4)%10+10)%10, yb=((sy-4)%12+12)%12;
  const n=m*100+d; let mi;
  if(n>=1207||n<106) mi=10; else if(n<204) mi=11;
  else { mi=0; for(let i=0;i<10;i++){ const [tm,td]=TERMS[i]; if(n>=tm*100+td) mi=i; } }
  const ms=((ys%5)*2+2+mi)%10, mb=(2+mi)%12;
  const di=((jdn(y,m,d)-2415021+10)%60+60)%60, ds=di%10, db=di%12;
  const P=[{l:'년주',s:ys,b:yb},{l:'월주',s:ms,b:mb},{l:'일주',s:ds,b:db}];
  if(hBr!==null){const hs=((ds%5)*2+hBr)%10;P.push({l:'시주',s:hs,b:hBr});} else P.push({l:'시주',s:null,b:null});
  const cnt=[0,0,0,0,0]; P.forEach(p=>{if(p.s!==null){cnt[STEM_EL[p.s]]++;cnt[BR_EL[p.b]]++;}});
  let low=0; for(let i=1;i<5;i++){ if(cnt[i]<cnt[low]) low=i; else if(cnt[i]===cnt[low] && ((di+i)%2===0)) low=i; }
  return {P,cnt,low:EL_KEYS[low]};
}

/* ---------- media engine ----------
   All clips are fetched into memory up front (blob URLs), the next clip is decoded on the hidden layer
   while the current one plays, and each clip hands off ~0.14s before its end with a short crossfade. */
const vA=$('vA'), vB=$('vB'), poster=$('poster');
let front=vA, back=vB, muted=false, cancelTok=0, useBlob=true;
const SRC={}, LOAD={}, LEAD=0.14, FADE=280;
function fetchClip(k){
  if(LOAD[k]) return LOAD[k];
  LOAD[k]=fetch(V[k]).then(r=>{ if(!r.ok) throw new Error(r.status); return r.blob(); })
    .then(b=>{ SRC[k]=useBlob?URL.createObjectURL(b):V[k]; })
    .catch(()=>{ SRC[k]=V[k]; });
  return LOAD[k];
}
const srcOf=k=>SRC[k]||V[k];
// verify this browser can play blob: media; otherwise fall back to (now cached) file URLs
const blobCheck=fetchClip('idle').then(()=>new Promise(res=>{
  if(!String(SRC.idle).startsWith('blob:')) return res();
  const t=document.createElement('video'); t.muted=true; t.preload='auto'; let fin=false;
  const end=ok=>{ if(fin) return; fin=true; if(!ok){ useBlob=false; for(const k in SRC) if(String(SRC[k]).startsWith('blob:')) SRC[k]=V[k]; } t.removeAttribute('src'); res(); };
  t.onloadedmetadata=()=>end(true); t.onerror=()=>end(false); t.src=SRC.idle; setTimeout(()=>end(false),3000);
}));
function prep(v,key){
  const gen=(v._gen||0)+1; v._gen=gen; v._key=key; v._ready=false;
  return (async()=>{
    await fetchClip(key); await blobCheck; if(v._gen!==gen) return;
    await new Promise(res=>{
      let ok=false; const done=()=>{ if(ok) return; ok=true; v.oncanplay=null; v.onerror=null; res(); };
      v._err=false; v.onerror=()=>{ v._err=true; done(); }; v.oncanplay=done;
      v.src=srcOf(key); v.load(); setTimeout(done,5000);
    });
    if(v._gen!==gen) return;
    if(!v._err){ try{ v.muted=true; await v.play(); v.pause(); v.currentTime=0; }catch(e){} } // warm decoder (iOS won't buffer otherwise)
    if(v._gen!==gen) return;
    v.muted=muted; v._ready=!v._err;
  })();
}
function setPoster(src){ if(src){poster.style.backgroundImage=`url("${src}")`;poster.classList.add('on');} else poster.classList.remove('on'); }
function subs(key){
  const box=$('subLines'); box.innerHTML=''; const lines=LINES[key]||[];
  $('who').classList.toggle('on',lines.length>0);
  return lines.map(t=>{const p=document.createElement('p');p.textContent=t;box.appendChild(p);return p;});
}
function clearSubs(){ $('subLines').innerHTML=''; $('who').classList.remove('on'); }
function schedule(els,dur,tok){
  if(!els.length) return;
  const total=els.reduce((a,e)=>a+e.textContent.length,0), span=Math.max(dur-0.45,1.2);
  let t=0.08; els.forEach((e,i)=>{ const at=t; setTimeout(()=>{ if(tok!==cancelTok) return; if(i>0) els[i-1].style.display='none'; e.classList.add('on'); },at*1000); t+=span*(e.textContent.length/total); });
}
function play(key,{loop=false,posterKey='host',showSubs=true,next=null}={}){
  const tok=++cancelTok;
  return new Promise(async resolve=>{
    let done=false; const finish=()=>{ if(done) return; done=true; resolve(); };
    const v=back;
    if(v._key!==key || !v._p) v._p=prep(v,key);
    await v._p;
    if(tok!==cancelTok) return;
    const els=showSubs?subs(key):(clearSubs(),[]);
    const fallback=()=>{ // clip unavailable: still + timed subs
      setPoster(POSTER[posterKey]||null); front.classList.remove('on'); back.classList.remove('on');
      const d=FALLBACK_DUR[key.startsWith('rv_')?'rv':key]||5; schedule(els,d,tok);
      if(!loop) setTimeout(()=>{ if(tok===cancelTok) finish(); },d*1000); else finish();
    };
    if(!v._ready) return fallback();
    v.loop=loop; v.muted=muted;
    try{ if(v.currentTime>0.04) v.currentTime=0; await v.play(); }catch(e){ return fallback(); }
    if(LINES[key]) bgm(BGM_LV.talk,.35); else if(key.startsWith('rv_')) bgm(BGM_LV.reveal,.6);
    v.classList.add('on'); front.classList.remove('on'); setPoster(null);
    const old=front; front=v; back=old;
    setTimeout(()=>{ if(back!==old) return; old.pause(); if(next && tok===cancelTok) old._p=prep(old,next); },FADE+60);
    schedule(els,v.duration||5,tok);
    if(loop) return finish();
    v.onended=()=>{ if(front===v) finish(); };
    const tick=()=>{ if(done||tok!==cancelTok) return; if(v.ended||(v.duration&&v.currentTime>=v.duration-LEAD)) return finish(); requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  });
}
function idle(next=null){ clearSubs(); bgm(BGM_LV.idle,1.2); return play('idle',{loop:true,showSubs:false,next}); }
function panel(id){ ['pChoice','pBirth','pWorry','pPartner','pMission'].forEach(p=>$(p).classList.toggle('on',p===id)); }
function toast(t){const e=$('toast');e.textContent=t;e.classList.add('on');setTimeout(()=>e.classList.remove('on'),1800);}

/* ---------- form setup ---------- */
(function(){
  const by=$('by'),bm=$('bm'),bd=$('bd'),bh=$('bh');
  for(let y=2008;y>=1960;y--) by.add(new Option(y+'년',y,false,y===1996));
  for(let m=1;m<=12;m++) bm.add(new Option(m+'월',m,false,m===5));
  const fillD=()=>{const n=new Date(+by.value,+bm.value,0).getDate(),cur=+bd.value||14;bd.innerHTML='';for(let d=1;d<=n;d++) bd.add(new Option(d+'일',d,false,d===Math.min(cur,n)));};
  fillD(); by.onchange=fillD; bm.onchange=fillD;
  const HN=['자시 (23~01시)','축시 (01~03시)','인시 (03~05시)','묘시 (05~07시)','진시 (07~09시)','사시 (09~11시)','오시 (11~13시)','미시 (13~15시)','신시 (15~17시)','유시 (17~19시)','술시 (19~21시)','해시 (21~23시)'];
  bh.add(new Option('시간 모름','x'));
  HN.forEach((h,i)=>bh.add(new Option(h,i)));
  $('solar').onclick=()=>{$('solar').setAttribute('aria-pressed','true');$('lunar').setAttribute('aria-pressed','false');};
  $('lunar').onclick=()=>{$('lunar').setAttribute('aria-pressed','true');$('solar').setAttribute('aria-pressed','false');};
  $('chips').querySelectorAll('.chip').forEach(c=>c.onclick=()=>{$('chips').querySelectorAll('.chip').forEach(x=>x.setAttribute('aria-pressed','false'));c.setAttribute('aria-pressed','true');});
})();

/* ---------- flow ---------- */
let S=null;
/* background music: one seamless loop, level follows the scene (loud in intro, ducked under speech) */
const BGM_LV={intro:.62,talk:.10,idle:.24,reveal:.34,result:.2};
let AC=null,bgmGain=null,bgmLevel=BGM_LV.intro,bgmBytes=null;
fetch('a/bgm.mp3').then(r=>r.ok?r.arrayBuffer():null).then(b=>{bgmBytes=b;}).catch(()=>{});
function bgm(lv,sec=.8){ bgmLevel=lv; if(!bgmGain) return; const g=bgmGain.gain,t=AC.currentTime; g.cancelScheduledValues(t); g.setValueAtTime(g.value,t); g.linearRampToValueAtTime(muted?0:lv,t+sec); }
function startBgm(){
  try{
    if(navigator.audioSession) navigator.audioSession.type='playback';
    AC=AC||new (window.AudioContext||window.webkitAudioContext)(); AC.resume();
    bgmGain=AC.createGain(); bgmGain.gain.value=0; bgmGain.connect(AC.destination);
  }catch(e){ return; }
  const go=bytes=>AC.decodeAudioData(bytes.slice(0),buf=>{
    const d=buf.getChannelData(0); let i=0; while(i<d.length&&Math.abs(d[i])<1e-4) i++;   // skip encoder priming
    const src=AC.createBufferSource(); src.buffer=buf; src.loop=true; src.loopStart=i/buf.sampleRate; src.loopEnd=Math.min(buf.duration,src.loopStart+48);
    src.connect(bgmGain); src.start(0,src.loopStart); bgm(bgmLevel,1.5);
  },()=>{});
  if(bgmBytes) go(bgmBytes); else fetch('a/bgm.mp3').then(r=>r.arrayBuffer()).then(go).catch(()=>{});
}
function unlock(){ startBgm(); return Promise.all([vA,vB].map(v=>{ try{ if(!v.getAttribute('src')){ v.src=srcOf('idle'); v._key='idle'; v._p=null; } v.muted=muted; const p=v.play(); return (p&&p.then?p:Promise.resolve()).then(()=>v.pause()).catch(()=>{}); }catch(e){ return Promise.resolve(); } })); }
async function startStory(){
  $('start').classList.add('off'); bgm(BGM_LV.intro,1); await play('intro',{posterKey:null,showSubs:false,next:'t1'}); await sceneOne();
}
async function sceneOne(){ await play('t1',{next:'idle'}); await idle(); panel('pChoice'); }
async function afterChoice(k){ panel(null); await play(k,{next:'t2'}); await askBirth(); }
async function askBirth(){ await play('t2',{next:'idle'}); await idle('t3'); panel('pBirth'); }
async function afterBirth(){
  panel(null);
  const y=+$('by').value,m=+$('bm').value,d=+$('bd').value,h=$('bh').value; S=calc(y,m,d,h==='x'?null:+h);
  fetchClip('rv_'+S.low);
  await play('t3',{next:'t4'}); await play('t4',{next:'idle'}); await idle('t5'); panel('pWorry');
}
async function afterWorry(){
  panel(null); await play('t5',{next:'rv_'+S.low});
  const g=GODS[S.low]; clearSubs();
  const f=$('flash'); f.classList.remove('go'); void f.offsetWidth; f.classList.add('go');
  POSTER['rv_'+S.low]='img/'+S.low+'.jpg';
  $('ncHanja').textContent=g.h; $('ncHanja').style.setProperty('--c',g.c); $('namecard').style.setProperty('--c',g.c);
  $('ncName').textContent=g.n; $('ncDesc').textContent=`네 사주에 모자란 기운 ${g.label} · ${g.desc}`;
  setTimeout(()=>$('namecard').classList.add('on'),700);
  await play('rv_'+S.low,{posterKey:'rv_'+S.low,showSubs:false,next:'t6'});
  $('namecard').classList.remove('on');
  await play('t6'); showResult();
}
function subMode(on){ $('stage').classList.toggle('subm',on); if(on) $('stage').classList.remove('homeMode'); }
function showResult(){ subMode(true);
  const g=GODS[S.low];
  $('rHero').style.backgroundImage=`url("img/${S.low}.jpg")`;
  $('rGod').textContent=`${g.h} · ${g.el} · ${g.dir}`; $('rName').textContent=`나의 수호신, ${g.n}`;
  $('rPillars').innerHTML=S.P.map(p=>`<div><div class="l">${p.l}</div><div class="c">${p.s===null?'<span style="color:var(--ink-3)">?</span>':`<span style="color:${EL_COL[STEM_EL[p.s]]}">${STEM[p.s]}</span><br><span style="color:${EL_COL[BR_EL[p.b]]}">${BR[p.b]}</span>`}</div></div>`).join('');
  const max=Math.max(...S.cnt,1), names=['목(木)','화(火)','토(土)','금(金)','수(水)'];
  $('rBars').innerHTML=S.cnt.map((c,i)=>`<div class="bar ${EL_KEYS[i]===S.low?'low':''}" style="--c:${EL_COL[i]}"><span class="lbl">${names[i]}</span><div class="t"><i data-w="${Math.max(c/max*100,4)}"></i></div><span class="v">${c}</span></div>`).join('');
  $('rMission').textContent=g.mission;
  $('result').classList.add('on'); bgm(BGM_LV.result,1.5);
  setTimeout(()=>$('rBars').querySelectorAll('i').forEach(i=>i.style.width=i.dataset.w+'%'),60);
}
$('enter').onclick=async()=>{ await unlock(); startStory(); };
$('skipStory').onclick=async()=>{ await unlock(); $('start').classList.add('off'); askBirth(); };
$('c1a').onclick=()=>afterChoice('t1a');
$('c1b').onclick=()=>afterChoice('t1b');
$('birthGo').onclick=afterBirth;
$('worryGo').onclick=afterWorry;
$('worrySkip').onclick=afterWorry;
/* ---------- partner reading (Sion) ---------- */
Object.assign(V,{e1:'v/sion/e1.mp4',e2:'v/sion/e2.mp4',e3:'v/sion/e3.mp4'});
Object.assign(LINES,{e1:['그 사람 얘기?','…생일 줘봐.'],e2:['흠.','이 사람, 요즘 너 생각','안 하는 척하느라 바빠.'],e3:['여기서부턴 진짜 속마음이야.','들을 준비 됐어?']});
Object.assign(FALLBACK_DUR,{e1:3.4,e2:5.5,e3:4.7}); POSTER.sion='img/sion.jpg';
(function(){
  const py=$('py'),pm=$('pm'),pd=$('pd');
  for(let y=2008;y>=1960;y--) py.add(new Option(y+'년',y,false,y===1994));
  for(let m=1;m<=12;m++) pm.add(new Option(m+'월',m,false,m===3));
  const fill=()=>{const n=new Date(+py.value,+pm.value,0).getDate(),cur=+pd.value||8;pd.innerHTML='';for(let d=1;d<=n;d++) pd.add(new Option(d+'일',d,false,d===Math.min(cur,n)));};
  fill(); py.onchange=fill; pm.onchange=fill;
  $('pchips').querySelectorAll('.chip').forEach(c=>c.onclick=()=>{$('pchips').querySelectorAll('.chip').forEach(x=>x.setAttribute('aria-pressed','false'));c.setAttribute('aria-pressed','true');});
})();
const P_EL={
  wood:['나무','한번 마음 준 건 쉽게 안 꺾여. 대신 먼저 굽히질 못해.'],
  fire:['불','마음은 빨리 타오르는데, 먼저 표현은 못 해.'],
  earth:['흙','티를 안 내. 근데 한번 자리 잡은 사람은 오래 품어.'],
  metal:['쇠','겉으론 칼같이 정리한 척해. 속은 아직 정리 못 했고.'],
  water:['물','생각이 많아. 연락을 안 하는 게 아니라 못 하는 거야.']};
const P_REL={
  '연락 끊김':['요즘 밤마다 네 프로필에 들어가 봐.','근데 흔적은 절대 안 남기지.'],
  '썸':['네 답장 오면 바로 안 열어.','일부러 몇 분 있다가 열어. 들킬까 봐.'],
  '연애 중':['요즘 말수가 줄었지?','식은 게 아니라, 혼자 뭘 감당하는 중이야.'],
  '헤어짐':['후회 안 한다고 말하고 다녀.','그 말을 제일 많이 하는 사람이 그 사람이야.']};
let hostName=null;
function asSion(on){ if(on){ hostName=hostName||$('who').textContent; $('who').textContent='시온'; } else if(hostName){ $('who').textContent=hostName; } }
async function partnerStart(){
  homeOff(); subMode(true); $('result').classList.remove('on'); asSion(true); fetchClip('e2'); fetchClip('e3');
  await play('e1',{posterKey:'sion',next:'e2'}); panel('pPartner'); bgm(BGM_LV.idle,1);
}
async function partnerGo(){
  panel(null);
  const R=calc(+$('py').value,+$('pm').value,+$('pd').value,null);
  let hi=0; for(let i=1;i<5;i++) if(R.cnt[i]>R.cnt[hi]) hi=i;
  const el=P_EL[EL_KEYS[hi]], day=R.P[2], rel=[...$('pchips').querySelectorAll('.chip')].find(c=>c.getAttribute('aria-pressed')==='true').textContent;
  $('rpTitle').textContent=`${STEM[day.s]}${BR[day.b]}일생, ${el[0]} 기운이 센 사람`;
  $('rpSub').textContent=`지금 둘은 · ${rel}`;
  $('b1').innerHTML=`은거울에 그 사람이 비쳤어.<br><b>${el[0]} 기운</b>이 강한 사람이라, ${el[1]}`;
  $('b2').innerHTML=P_REL[rel].join('<br>');
  $('b3').innerHTML='보낼까 말까.<br>이번 주에만 <b>세 번</b>은 이랬어.';
  $('payWrap').classList.remove('on'); $('moreWrap').style.display='';
  await play('e2',{posterKey:'sion',next:'e3'}); clearSubs();
  $('report').scrollTop=0; $('report').classList.add('on'); bgm(BGM_LV.idle,1);
}
async function partnerMore(){
  $('report').classList.remove('on');
  await play('e3',{posterKey:'sion'}); clearSubs();
  $('moreWrap').style.display='none'; $('payWrap').classList.add('on'); $('report').classList.add('on'); bgm(BGM_LV.result,1);
  requestAnimationFrame(()=>$('payWrap').scrollIntoView({behavior:'smooth',block:'start'}));
}
$('ctaPartner').onclick=partnerStart;
$('partnerGo').onclick=partnerGo;
$('rpMore').onclick=partnerMore;
$('payGo').onclick=()=>toast('체험판: 결제 화면으로 이동합니다');
$('ctaPay').onclick=()=>toast('체험판: 결제 화면으로 이동합니다');
/* ---------- membership demo ---------- */
const MS={wood:{push:'일어났어? 오늘 미션 왔어 🌿',l:['좋은 아침.','오늘은 초록색 하나 걸치고,','동쪽으로 딱 10분만 걸어.']},
  fire:{push:'일어나. 오늘 미션 하나 줄게 🔥',l:['일어났어?','오늘은 네가 먼저 연락해.','망설이면 불 꺼진다.']},
  earth:{push:'잘 잤어? 오늘 미션 가져왔어',l:['잘 잤어?','책상 위 하나만 정리하자.','네 자리가 단단해야 운이 앉아.']},
  metal:{push:'미션 도착. 오늘은 짧아.',l:['오늘,','안 맞는 약속 하나 끊어.','비워야 들어와.']},
  water:{push:'…깼어? 미션 보냈어 🌙',l:['물 한 잔 먼저 마셔.','그리고 오늘 하루,','세 줄만 적어.']}};
ORDER.forEach(k=>{ V['m_'+k]='v/ms/'+k+'.mp4'; LINES['m_'+k]=MS[k].l; FALLBACK_DUR['m_'+k]=6; POSTER['m_'+k]='img/'+k+'.jpg'; });
const ov=id=>{ ['ovPre','ovSys','ovNight','ovLock','ovGauge','ovSub','ovKv'].forEach(x=>$(x).classList.toggle('on',x===id)); };
const wait=ms=>new Promise(r=>setTimeout(r,ms));
const iga=n=>{ const c=n.charCodeAt(n.length-1)-0xAC00; return n+((c>=0&&c%28)?'이':'가'); };
function memberStart(){
  const g=GODS[S.low]; fetchClip('m_'+S.low);
  $('preAv').style.backgroundImage=`url("img/${S.low}.jpg")`;
  $('preTx').innerHTML=`내일 아침 8시,<br>${iga(g.n)} 첫 개운 미션 보낼게.<br>알림 켜줄래?`;
  ov('ovPre');
}
async function nextMorning(){
  const g=GODS[S.low]; ov('ovNight'); $('result').classList.remove('on'); bgm(0.05,1);
  const t=$('nightT'); t.textContent='07:59'; await wait(1100); t.textContent='08:00'; await wait(800);
  const d=new Date(Date.now()+864e5), W='일월화수목금토';
  $('lockD').textContent=`${d.getMonth()+1}월 ${d.getDate()}일 ${W[d.getDay()]}요일`;
  $('ovLock').style.backgroundImage=`url("img/${S.low}.jpg")`; $('notiPic').style.backgroundImage=`url("img/${S.low}.jpg")`;
  $('notiN').textContent=g.n; $('notiM').textContent=MS[S.low].push; $('noti').classList.remove('on');
  ov('ovLock'); await wait(900); $('noti').classList.add('on');
}
async function openMission(){
  const g=GODS[S.low]; ov(null); homeOff(); subMode(true); hostName=hostName||$('who').textContent; $('who').textContent=g.n;
  await play('m_'+S.low,{posterKey:'m_'+S.low}); clearSubs();
  $('mK').textContent=`오늘의 개운 미션 · ${g.n} (${g.el})`; $('mTx').textContent=g.mission; panel('pMission'); bgm(BGM_LV.idle,1);
}
function showGauge(){
  panel(null); subMode(true); const g=GODS[S.low], idx=EL_KEYS.indexOf(S.low);
  $('gTitle').innerHTML=`비어 있던 ${g.label} 기운이<br>조금 채워졌어.`;
  const names=['목(木)','화(火)','토(土)','금(金)','수(水)'], cnt=S.cnt.slice(), max=Math.max(...cnt,1)+1;
  $('gBars').innerHTML=cnt.map((c,i)=>`<div class="bar ${i===idx?'low':''}" style="--c:${EL_COL[i]}"><span class="lbl">${names[i]}</span><div class="t"><i data-w="${Math.max(c/max*100,4)}"></i></div><span class="v">${c}${i===idx?'<em class="gUp">+0.2</em>':''}</span></div>`).join('');
  $('gStreak').innerHTML=['1일','2','3','4','5','6','7'].map((x,i)=>`<span class="${i===0?'on':''}">${i===0?'✓':x}</span>`).join('');
  $('gStreakTx').textContent=`7일 채우면 ${g.n}의 음성 편지가 열려.`;
  const base=new Date(Date.now()+18*864e5), yy=base.getFullYear(), m=base.getMonth();
  $('kd1').textContent=`${m+1}월 17일`; $('kd2').textContent=`${m+1}월 22일`;
  $('calH').textContent=`${m+1}월 기운 캘린더`;
  const first=new Date(yy,m,1).getDay(), days=new Date(yy,m+1,0).getDate(), today=new Date(Date.now()+864e5);
  let h='일월화수목금토'.split('').map(w=>`<div class="w">${w}</div>`).join('')+'<div></div>'.repeat(first);
  for(let d=1;d<=days;d++){ const cls=(d===17||d===22)?'k':(today.getMonth()===m&&today.getFullYear()===yy&&today.getDate()===d?'t':''); h+=`<div class="d ${cls}">${d}</div>`; }
  $('gCal').innerHTML=h;
  ov('ovGauge'); $('ovGauge').scrollTop=0;
  setTimeout(()=>{ $('gBars').querySelectorAll('i').forEach((el,i)=>el.style.width=el.dataset.w+'%'); },80);
  setTimeout(()=>{ const i=$('gBars').querySelectorAll('i')[idx]; const w=Math.min(+i.dataset.w+100/max*0.9,100); i.style.width=w+'%'; const u=$('gBars').querySelector('.gUp'); if(u) u.classList.add('on'); },1300);
}
$('ctaPush').onclick=memberStart;
$('preYes').onclick=()=>ov('ovSys');
$('preNo').onclick=()=>ov(null);
$('sysYes').onclick=nextMorning;
$('sysNo').onclick=()=>{ ov(null); toast('알림 없이도 앱에서 미션을 볼 수 있어요'); };
$('noti').onclick=openMission;
$('mDone').onclick=showGauge;
$('mLater').onclick=showGauge;
$('gSub').onclick=()=>{ ov('ovSub'); $('ovSub').scrollTop=0; bgm(BGM_LV.result,1); };
/* ---------- main home ---------- */
Object.assign(V,{halmae:'v/halmae.mp4'}); LINES.halmae=['왔구나.','…네 내년 열두 달,','이 할미가 다 봐 뒀다.','섣달에 보자.']; FALLBACK_DUR.halmae=8; POSTER.halmae='img/halmae.jpg';
function ensureS(){ if(!S) S=calc(1996,5,14,6); }
function homeOff(){ $('home').classList.remove('on'); $('tabs').classList.remove('on'); $('toTop').classList.remove('on'); $('stage').classList.remove('homeMode'); }
function renderHome(){
  ensureS(); const g=GODS[S.low];
  $('hMis').style.setProperty('--c',g.c);
  $('hMisAv').style.backgroundImage=`url("img/${S.low}.jpg")`;
  $('hMisK').innerHTML=`오늘의 개운 · <em>${g.n} ${g.el}</em>`; $('hMisT').textContent=g.mission;
  const max=Math.max(...S.cnt,1), names='木火土金水';
  $('hG').innerHTML=S.cnt.map((c,i)=>`<div class="${EL_KEYS[i]===S.low?'low':''}" style="--c:${EL_COL[i]};--w:${Math.max(c/max*100,6)}%"><b>${names[i]}</b><i></i></div>`).join('');
  $('hMem').innerHTML=ORDER.map(k=>{const m=GODS[k];return `<button class="om ${k===S.low?'mine':''}" data-el="${k}" style="--c:${m.c}"><span style="background-image:url('img/${k}.jpg')"></span><b>${m.n}</b><small>${m.h} · ${m.el}</small></button>`;}).join('');
  $('hMem').querySelectorAll('.om').forEach(e=>e.onclick=()=>memberView(e.dataset.el));
}
function showHome(){
  renderHome(); ov(null); panel(null); clearSubs();
  ['result','report'].forEach(x=>$(x).classList.remove('on')); $('start').classList.add('off');
  if(hostName){ $('who').textContent=hostName; }
  subMode(false); $('stage').classList.add('homeMode'); $('home').classList.add('on'); $('tabs').classList.add('on'); $('home').scrollTop=0;
  $('tabs').querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.dataset.t==='home'));
  bgm(BGM_LV.idle,1);
}
async function memberView(el){
  const g=GODS[el]; homeOff(); subMode(true); fetchClip('rv_'+el); POSTER['rv_'+el]='img/'+el+'.jpg';
  $('ncHanja').textContent=g.h; $('ncHanja').style.setProperty('--c',g.c); $('namecard').style.setProperty('--c',g.c);
  $('ncName').textContent=g.n; $('ncDesc').textContent=g.desc; $('namecard').querySelector('.k').textContent=el===S.low?'나의 수호신':'오방 멤버';
  setTimeout(()=>$('namecard').classList.add('on'),500);
  await play('rv_'+el,{posterKey:'rv_'+el,showSubs:false});
  await wait(1200); $('namecard').classList.remove('on'); showHome();
}
const KV={
  halmae:{img:'img/halmae.jpg',k:'2027 신년 종합 상담 · 12월 오픈',t:'삼신 할매가 온다',p:'태어나는 날을 점지한 삼신 할매가, 너의 2027년 열두 달을 한 번에 읽어준다. 월별 흐름, 조심할 달, 인연이 들어오는 달까지.',b:'오픈 알림 받기'},
  house:{img:'img/kv_house.jpg',k:'COMING SOON · 시즌제 사주 리얼리티',t:'오행 하우스 시즌1',p:'네가 입소하는 순간 시작된다. 다섯 명의 신과 한 집에서, 궁합으로 흘러가는 일주일. 마지막 날, 너는 누구를 고를까.',b:'입소 신청하기'},
  drama:{img:'img/kv_drama.jpg',k:'COMING SOON · 월간 연재',t:'내 인생 12부작',p:'네 사주의 열두 달이 한 편씩 드라마가 된다. 서하가 내레이션하고, 오방 멤버가 상대역으로 출연하는, 너만 주인공인 이야기.',b:'1화 알림 받기'}};
function openKv(key){ const k=KV[key]; $('kvImg').src=k.img; $('kvK').textContent=k.k; $('kvT').textContent=k.t; $('kvP').textContent=k.p; $('kvGo').textContent=k.b; ov('ovKv'); }
async function halmaeTeaser(){
  homeOff(); subMode(true); fetchClip('halmae'); hostName=hostName||$('who').textContent; $('who').textContent='삼신 할매';
  await play('halmae',{posterKey:'halmae'}); clearSubs(); await wait(500); openKv('halmae');
}
$('cDohwa').onclick=()=>{ try{ sessionStorage.setItem('toHome','1'); }catch(e){} location.href='dohwa.html'; };
document.querySelectorAll('[data-kv]').forEach(e=>e.onclick=()=>{ if(e.dataset.kv==='halmae') halmaeTeaser(); else openKv(e.dataset.kv); });
$('kvGo').onclick=()=>{ toast('체험판: 오픈 알림이 신청되었어요'); showHome(); };
$('kvClose').onclick=()=>{ if($('home').classList.contains('on')) ov(null); else showHome(); };
$('hMis').onclick=()=>{ fetchClip('m_'+S.low); openMission(); };
$('cPartner').onclick=()=>partnerStart();
$('tBal').onclick=()=>showGauge();
document.querySelectorAll('[data-go]').forEach(e=>e.onclick=()=>{ if(e.dataset.go==='partner') partnerStart(); else { fetchClip('m_'+S.low); openMission(); } });
document.querySelectorAll('.lockc').forEach(e=>e.onclick=()=>toast('정식 오픈 때 열려요'));
$('hBell').onclick=()=>toast('내일 아침 8시, 수호신 미션이 예약돼 있어요'); $('hMenu').onclick=()=>toast('메뉴는 정식 오픈 때 열려요');
$('pills').querySelectorAll('button').forEach(b=>b.onclick=()=>{
  const c=b.dataset.c; $('pills').querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
  $('home').querySelectorAll('[data-cats]').forEach(sec=>sec.hidden=!sec.dataset.cats.split(' ').includes(c));
  $('home').scrollTo({top:0,behavior:'smooth'});
});
$('home').addEventListener('scroll',()=>$('toTop').classList.toggle('on',$('home').scrollTop>700));
$('toTop').onclick=()=>$('home').scrollTo({top:0,behavior:'smooth'});
$('tabs').querySelectorAll('button').forEach(b=>b.onclick=()=>{
  const t=b.dataset.t; $('tabs').querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
  if(t==='home') $('home').scrollTo({top:0,behavior:'smooth'});
  else if(t==='cns') $('secCns').scrollIntoView({behavior:'smooth'});
  else if(t==='mem') $('secMem').scrollIntoView({behavior:'smooth'});
  else if(t==='mission') $('hMis').click();
  else toast('보관함은 정식 오픈 때 열려요');
});
$('backBtn').onclick=()=>{
  cancelTok++; [vA,vB].forEach(v=>{ try{ v.pause(); }catch(e){} }); clearSubs();
  $('namecard').classList.remove('on'); $('flash').classList.remove('go');
  showHome();
};
$('ctaHome').onclick=showHome;
$('goHome').onclick=async()=>{ await unlock(); showHome(); };
document.querySelectorAll('[data-home]').forEach(b=>b.onclick=showHome);
$('subGo').onclick=()=>toast('체험판: 7일 무료 체험이 시작됩니다');
$('ctaShare').onclick=()=>toast('체험판: 공유 카드 생성');
$('muteBtn').onclick=()=>{ muted=!muted; [vA,vB].forEach(v=>v.muted=muted); bgm(bgmLevel,.2); $('waves').style.display=muted?'none':''; $('muteBtn').setAttribute('aria-label',muted?'소리 켜기':'소리 끄기'); };
$('restartBtn').onclick=()=>{ location.reload(); };
// initial: intro still as backdrop, load everything in background, pre-decode intro on the hidden layer
setPoster(HOST.introPoster);
const CORE=['intro','idle','t1','t1a','t1b','t2','t3','t4','t5','t6'], NEED=['intro','idle','t1'];
let nDone=0; const enter=$('enter'), skip=$('skipStory'), lab=enter.textContent;
const upd=()=>{ const pct=Math.round(nDone/CORE.length*100); $('loadbar').style.width=pct+'%'; $('loadtxt').textContent=pct<100?`영상 준비 중 ${pct}%`:'준비 완료'; };
enter.disabled=skip.disabled=true; enter.textContent='준비 중…';
(async()=>{ const q=CORE.slice(); const worker=async()=>{ while(q.length){ const k=q.shift(); await fetchClip(k); nDone++; upd(); } }; await Promise.all([worker(),worker(),worker()]); })();
Promise.all(NEED.map(fetchClip)).then(()=>blobCheck).then(()=>{ back._p=prep(back,'intro'); return back._p; }).then(()=>{ enter.disabled=skip.disabled=false; enter.textContent=lab; });
let backHome=false; try{ backHome=sessionStorage.getItem('toHome')==='1'; sessionStorage.removeItem('toHome'); }catch(e){}
if(backHome) showHome();
window.addEventListener('pageshow',e=>{ if(e.persisted&&!$('home').classList.contains('on')) showHome(); });
})();
</script>
